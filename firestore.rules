rules_version = '2';
// All app data (users, tickets, companies, …) is read and written only by the Next.js server through the
// Firebase Admin SDK, which bypasses these rules. Browsers may only touch the realtime helper paths below;
// everything else is denied by default.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/ticketNotifications/{docId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if false;
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
    }

    match /ticket_presence/{ticketId}/viewers/{viewerId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == viewerId;
      allow delete: if request.auth != null && request.auth.uid == viewerId;
    }

    match /ticket_data_sync/{ticketId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
