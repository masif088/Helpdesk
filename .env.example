# ─────────────────────────────────────────────────────────────────────────────
# Helpdesk — environment variables
#
#   cp .env.example .env.local     then fill in the values below.
#
# NEVER commit .env.local (it is git-ignored). Only this example file is tracked.
# NEXT_PUBLIC_* values are baked into the build: rebuild after changing them.
# On Firebase App Hosting the same values go in apphosting.yaml (public values) and
# Secret Manager (secrets), not in a .env file.
# ─────────────────────────────────────────────────────────────────────────────


# ═══ REQUIRED ════════════════════════════════════════════════════════════════

# ── Firebase project ─────────────────────────────────────────────────────────
# Create a project at https://console.firebase.google.com, then:
#   1. Authentication → Sign-in method → enable Email/Password
#   2. Firestore Database → create (Native mode)
#   3. Project settings → General → add a Web app → copy the config below
#   4. Project settings → Service accounts → Generate new private key → copy 3 values below
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Service account (server only, from the downloaded JSON key). Keep the quotes and the \n escapes.
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Public URL of the app, no trailing slash. Used in emails, rating links and the Gmail OAuth redirect.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ═══ FIRST RUN ═══════════════════════════════════════════════════════════════

# The first visit to a new database opens /setup (name the app + create the first admin).
# On a PUBLIC server set a token first: /setup then asks for it, so nobody else can claim the app.
# SETUP_TOKEN=

# Only for `npm run db:seed` (terminal alternative to /setup)
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=change-me-please
# SEED_ADMIN_NAME=Admin


# ═══ EMAIL (Gmail OAuth) — optional, needed to turn incoming email into tickets ═
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Enable the Gmail API and add this redirect URI: <NEXT_PUBLIC_SITE_URL>/api/email/google/callback
# Then connect the mailbox in Settings → Email Integration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ═══ SCHEDULED JOBS — optional, needed for email sync, recurring tickets, SLA alerts ═
# Any long random string. The scheduler (Google Apps Script or Cloud Scheduler) sends it as
# "Authorization: Bearer <secret>". Setup guide: docs/cron-jobs.md
SYNC_INBOX_CRON_SECRET=

# Signs the "Rate this ticket" links in the closing email (falls back to SYNC_INBOX_CRON_SECRET)
# CSAT_LINK_SECRET=


# ═══ BRANDING — optional (Settings → Branding overrides name, logo and favicon) ═
NEXT_PUBLIC_APP_NAME=Helpdesk
NEXT_PUBLIC_APP_TITLE=Helpdesk — Client Support
NEXT_PUBLIC_APP_DESCRIPTION=Ticketing and client support
# Relative = public/brand/logo.svg, or a full https:// URL
NEXT_PUBLIC_APP_LOGO=brand/logo.svg
# NEXT_PUBLIC_APP_FAVICON=brand/favicon.png


# ═══ AI (summaries and reply drafts) — optional ══════════════════════════════
# Settings → AI Integration (saved in the database) wins; these are the fallback.
# AI_PROVIDER=openai                       # openai | codex
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# CODEX_API_KEY=dummy                      # only with AI_PROVIDER=codex
# CODEX_BASE_URL=http://your-proxy/v1
# CODEX_MODEL=gpt-5.4


# ═══ FILE STORAGE — optional ═════════════════════════════════════════════════
# firebase (default) | local (files under ./storage-data, for a VPS)
# STORAGE_PROVIDER=firebase
# FIREBASE_STORAGE_BUCKET=                 # defaults to NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET
# STORAGE_LOCAL_DIR=./storage-data
# STORAGE_LOCAL_PUBLIC_URL=/api/storage/file


# ═══ PUSH NOTIFICATIONS — optional ═══════════════════════════════════════════
# Firebase console → Project settings → Cloud Messaging → Web Push certificates
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=


# ═══ ADVANCED — optional ═════════════════════════════════════════════════════
# Public URL used for online-payment return links (defaults to the request's own address)
# AUTH_URL=
# Send the session cookie without `Secure` (plain http, e.g. a VPS by IP). Detected automatically by default.
# AUTH_COOKIE_SECURE=false
# Seconds the ticket lookup catalog (statuses, types, tags …) is cached; minimum 30, default 1800
# TICKETS_LOOKUP_CATALOG_REVALIDATE_SECONDS=1800
# Send automation run logs to your own webhook
# AUTOMATION_LOG_WEBHOOK_URL=
# AUTOMATION_LOG_SECRET=
# Dev only: log every Firestore round trip with its duration
# FSDB_TRACE=1

# Local development against the Firebase emulators instead of a real project:
#   npx firebase-tools emulators:start --only firestore,auth --project demo-helpdesk
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
